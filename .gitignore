.ruff_cache/

# Node
node_modules/
frontend/dist/

# Generated artefacts. Everything here is rebuilt by:
#   uv run python scripts/run_clustering.py
outputs/

# Source data that is downloaded, not authored. 2.7 MB, fetched on first run
