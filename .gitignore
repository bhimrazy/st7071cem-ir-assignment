# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# frontend/dist IS committed, unlike most build output. FastAPI serves it at
# "/" and deployment builds the Python app only, with no Node step, so an
# ignored dist means a deployed site with a working /api and a 404 homepage.
# Rebuild with `npm run build` in frontend/ after changing the interface.

# Generated artefacts, rebuilt by `uv run ir-cluster`. Ignored except the two
# the API needs: without them the first request to the clustering task
# downloads the BBC corpus and fits k-means before it can answer, which a
# deployment should not be doing on a visitor's request. The figures stay out,
# because the interface draws its charts from the report JSON and the report
# keeps its own copies.
outputs/**
!outputs/clustering/
!outputs/clustering/kmeans_model.pkl
!outputs/clustering/clustering_report.json

# Source data that is downloaded, not authored. 2.7 MB, fetched on first run
# from http://mlg.ucd.ie/files/datasets/bbc-fulltext.zip
data/clustering/*.zip

# The crawled publication corpus IS committed: it is the result of a polite,
# rate-limited crawl that takes several minutes and hits a live university
# server, so a checkout should not have to repeat it just to run the search
# engine. data/listings (hand-saved, since the portal blocks these for a
# script) is committed for the same reason. data/index is derived from the
# corpus and rebuildable with `uv run ir-index`, but it is committed too so
# the API serves on a fresh checkout without a build step first.

# Working notes and the build log. Kept out of the repo deliberately.
.idea/

.DS_Store
